#!/bin/sh
# create SHAPE N [LANES]: make the pipes, tees and merges SHAPE needs over N
# seats, LANES lanes each (even, default 2), write the map, print the patch's
# directory. The pieces come from icc-pipes, icc-tee and icc-merge, found in
# sibling checkouts; the bay makes nothing but the map.
set -eu
[ $# -ge 2 ] || { echo "usage: create SHAPE N [LANES]" >&2; exit 1; }
shape=$1; n=$2; lanes=${3:-2}
case $shape in ring|mesh|tee-ring|tee-mesh) ;;
  *) echo "shape is ring, mesh, tee-ring or tee-mesh" >&2; exit 1;; esac
[ "$n" -ge 1 ] 2>/dev/null || { echo "seats must be 1 or more" >&2; exit 1; }
top=$(cd "$(dirname "$0")/../../../.." && pwd)
P=$(cd "${ICC_PIPES:-$top/../ICC-Pipes}/.claude/skills/icc-pipes/scripts" && pwd)
T=$(cd "${ICC_TEE:-$top/../ICC-Tee}/.claude/skills/icc-tee/scripts" && pwd)
M=$(cd "${ICC_MERGE:-$top/../ICC-Merge}/.claude/skills/icc-merge/scripts" && pwd)
d=$(mktemp -d /tmp/icc-patch-XXXXXXXX)
echo "$shape $n $lanes" > "$d/patch"; : > "$d/made"
trap '"$(dirname "$0")/remove" "$d"' EXIT
pipe() { p=$("$P/create" "$lanes"); echo "$P $p" >> "$d/made"; echo "$p"; }
end() { echo "$1 $2 $3 $(echo "$4" | tr ' ' ,)" >> "$d/patch"; }
cable() {  # cable A B: one pipe, seat A on side 0, seat B on side 1
  p=$(pipe); end "$1" 0 "$p" "$2"; end "$2" 1 "$p" "$1"
}
all=; i=0; while [ "$i" -lt "$n" ]; do all="$all $i"; i=$((i + 1)); done
case $shape in
  ring) m=$n; [ "$n" -eq 2 ] && m=1
        i=0; while [ "$i" -lt "$m" ]; do cable "$i" $(( (i + 1) % n )); i=$((i + 1)); done
        trap - EXIT; echo "$d"; exit ;;
  mesh) for i in $all; do for j in $all; do [ "$j" -gt "$i" ] && cable "$i" "$j"; done; done
        trap - EXIT; echo "$d"; exit ;;
esac
# Through fittings. Seat i writes one end and reads one end. readers I says
# who reads what I writes; writers R says who writes what R reads. A writer
# with one reader gets no tee, a reader with one writer no merge.
readers() { case $shape in tee-mesh) echo "$all";;
  *) j=$(( ($1 + 1) % n )); [ "$j" -eq "$1" ] && echo "$1" || echo "$j $1";; esac; }
writers() { case $shape in tee-mesh) echo "$all";;
  *) j=$(( ($1 + n - 1) % n )); [ "$j" -eq "$1" ] && echo "$1" || echo "$j $1";; esac; }
for i in $all; do for r in $(readers "$i"); do eval "x_${i}_$r=\$(pipe)"; done; done
for i in $all; do
  set -- $(readers "$i")
  if [ $# -eq 1 ]; then eval "e=\$x_${i}_$1"
  else e=$(pipe); outs=; for r; do eval "outs=\"\$outs \$x_${i}_$r\""; done
    t=$("$T/create" "$e" 0 $outs); echo "$T $t" >> "$d/made"; fi
  end "$i" 0 "$e" "$*"
done
for r in $all; do
  set -- $(writers "$r")
  if [ $# -eq 1 ]; then eval "e=\$x_$1_$r"
  else e=$(pipe); ins=; for i; do eval "ins=\"\$ins \$x_${i}_$r\""; done
    g=$("$M/create" "$e" 0 $ins); echo "$M $g" >> "$d/made"; fi
  end "$r" 1 "$e" "$*"
done
trap - EXIT
echo "$d"
