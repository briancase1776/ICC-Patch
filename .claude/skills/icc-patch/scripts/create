#!/bin/sh
# .claude/skills/icc-patch/scripts/create
# create SHAPE N [LANES]: make the pipes, tees and merges SHAPE needs over N
# seats, LANES lanes each (even, default 2), write the map, print the patch's
# directory. The pieces come from icc-pipes, icc-tee and icc-merge, found in
# sibling checkouts; the bay makes nothing but the map.
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT License text omitted for brevity, See LICENCE.TXT
set -eu
[ $# -ge 2 ] || { echo "usage: create SHAPE N [LANES]" >&2; exit 1; }
shape=$1; n=$2; lanes=${3:-2}
case $shape in ring|mesh|ring-p|mesh-p) ;;
  *) echo "shape is ring, mesh, ring-p or mesh-p" >&2; exit 1;; esac
[ "$n" -ge 1 ] 2>/dev/null || { echo "seats must be 1 or more" >&2; exit 1; }
top=$(cd "$(dirname "$0")/../../../.." && pwd)
P=$(cd "${ICC_PIPES:-$top/../ICC-Pipes}/.claude/skills/icc-pipes/scripts" && pwd)
T=$(cd "${ICC_TEE:-$top/../ICC-Tee}/.claude/skills/icc-tee/scripts" && pwd)
M=$(cd "${ICC_MERGE:-$top/../ICC-Merge}/.claude/skills/icc-merge/scripts" && pwd)
d=$(mktemp -d /tmp/icc-patch-XXXXXXXX)
echo "$shape $n $lanes" > "$d/patch"; : > "$d/made"
trap '"$(dirname "$0")/remove" "$d"' EXIT
pipe() { p=$("$P/create" "$lanes"); echo "$P $p" >> "$d/made"; echo "$p"; }
tee() { t=$("$T/create" "$@"); echo "$T $t" >> "$d/made"; }
merge() { g=$("$M/create" "$@"); echo "$M $g" >> "$d/made"; echo "$g"; }
end() {  # end SEAT SIDE DIR PEERS [MERGE]: one map line
  echo "$1 $2 $3 $(echo "$4" | tr ' ' ,)${5:+ $5}" >> "$d/patch"
}
cable() {  # cable A B: one pipe, seat A on side 0, seat B on side 1
  p=$(pipe); end "$1" 0 "$p" "$2"; end "$2" 1 "$p" "$1"
}
all=0; i=1; while [ "$i" -lt "$n" ]; do all="$all $i"; i=$((i + 1)); done
case $shape in
  ring)
    case $n in 1) cable 0 0 ;; 2) cable 0 1 ;;
      *) for i in $all; do cable "$i" $(( (i + 1) % n )); done ;; esac ;;
  mesh|mesh-p)
    set -- $all; [ "$shape" = mesh ] || set -- "$@" p
    case $# in 1) ;; 2) cable "$1" "$2" ;;
      *) seats=$*; b=$(pipe); ins=; outs=
         for s in $seats; do ins="$ins $(pipe)"; outs="$outs $(pipe)"; done
         g=$(merge "$b" 0 $ins); tee "$b" 0 $outs
         for s in $seats; do
           set -- $ins; w=$1; shift; ins=$*
           set -- $outs; r=$1; shift; outs=$*
           end "$s" 0 "$w" "$seats" "$g"; end "$s" 1 "$r" "$seats"
         done ;; esac ;;
  ring-p)
    ws=; rs=; xs=
    for i in $all; do
      w=$(pipe); r=$(pipe); x=$(pipe); ws="$ws $w"; rs="$rs $r"; xs="$xs $x"
      tee "$w" 0 "$r" "$x"
    done
    q=$x; v=$r; g=
    [ "$n" -eq 1 ] || { q=$(pipe); g=$(merge "$q" 0 $xs); v=$(pipe); tee "$v" 0 $rs; }
    for i in $all; do j=$(( (i + 1) % n ))
      set -- $ws; w=$1; shift; ws=$*
      set -- $rs; r=$1; shift; rs=$*
      end "$i" 0 "$w" "$j p" "$g"; end "$j" 1 "$r" "$i p"
    done
    end p 1 "$q" "$all"; end p 0 "$v" "$all" ;;
esac
trap - EXIT
echo "$d"
