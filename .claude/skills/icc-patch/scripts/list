#!/bin/bash
# .claude/skills/icc-patch/scripts/list
# list: one line per patch, "DIR up|down SHAPE N LANES".
# Up means every pipe and fitting in it says up. A patch whose made file is
# gone is down: nothing can say its pieces are up, and its pieces cannot be
# reached to remove.
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT License text omitted for brevity, See LICENCE.TXT
set -eu
# Ask each skill once what it has, not once per piece it has: a sibling's list
# names every piece of its kind on the box, so asking per piece makes listing
# one patch cost as much as everyone else's work put together.
u=$(mktemp); trap 'rm -f "$u"' EXIT
mapfile -t scs < <(cut -d' ' -f1 /tmp/icc-patch-*/made 2>/dev/null | sort -u)
# A sibling that will not answer leaves its pieces out of $u, and the patches
# holding them read down. That is this script's whole job; it is not an error
# to stop for, so the loop keeps the tolerance the pipeline it replaced had.
for sc in "${scs[@]}"; do
  [[ -x $sc/list ]] || continue
  "$sc/list" | cut -d' ' -f1,2
done > "$u" || :
# A patch can go while this runs. That is a normal thing on a shared box, not
# an error: read each file once, and skip a patch that is no longer there.
for d in /tmp/icc-patch-*/; do
  d=${d%/}
  read -r h 2>/dev/null < "$d/patch" || h=
  [[ -n $h ]] || continue
  made=()
  if mapfile -t made 2>/dev/null < "$d/made"; then
    s=up
    # Each made line is "SCRIPTS DIR"; what a sibling's list says up is DIR.
    for l in "${made[@]}"; do
      grep -qxF "${l#* } up" "$u" || s=down
    done
  else
    s=down
  fi
  echo "$d $s $h"
done
